<Window x:Class="CFRezManager.CftPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280" Height="760" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Padding="14,6"
                        Margin="16,0,0,0" Click="ExportButton_Click"/>
                <TextBlock x:Name="FileNameText" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12,6"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource AppMutedTextBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
        <DataGrid x:Name="TableGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader" HeadersVisibility="All"
                  GridLinesVisibility="All" BorderThickness="0" RowHeight="28"
                  Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}"
                  RowBackground="{DynamicResource AppSurfaceBrush}"
                  AlternatingRowBackground="{DynamicResource AppSurfaceAltBrush}"
                  AlternationCount="2" HorizontalGridLinesBrush="{DynamicResource AppBorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource AppBorderBrush}"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" LoadingRow="TableGrid_LoadingRow"/>
    </DockPanel>
</Window>
