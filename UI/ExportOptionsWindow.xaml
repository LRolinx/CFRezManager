<Window x:Class="CFRezManager.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出格式设置"
        Width="760"
        Height="590"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="导出格式设置"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Margin="0,8,0,16"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="请为每类可解码图片资源选择导出源文件，或导出解码后的标准 PNG。"/>

        <Border Grid.Row="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Background="{DynamicResource AppSurfaceAltBrush}" Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="184"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FormatHeaderText"
                               Text="文件格式"
                               FontWeight="SemiBold"
                               Margin="14,10"/>
                    <TextBlock x:Name="KnownLayoutsHeaderText"
                               Grid.Column="1"
                               Text="已知编码 / 压缩布局"
                               FontWeight="SemiBold"
                               Margin="14,10"/>
                    <TextBlock x:Name="OutputHeaderText"
                               Grid.Column="2"
                               Text="导出内容"
                               FontWeight="SemiBold"
                               Margin="14,10"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FormatRowsPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Name="FallbackText"
                   Grid.Row="3"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="无法识别为图片的 BIN（例如脚本或配置表）以及解码失败的文件会保留原扩展名和源数据。当前选择会自动保存。"/>

        <CheckBox x:Name="DoNotShowAgainCheckBox"
                  Grid.Row="4"
                  Margin="0,14,0,0"
                  VerticalAlignment="Center"
                  Content="下次导出不再显示此窗口（可在设置中重新打开）"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    MinWidth="88"
                    Padding="16,8"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="ExportButton"
                    Content="继续导出"
                    MinWidth="104"
                    Padding="16,8"
                    IsDefault="True"
                    Click="ExportButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
